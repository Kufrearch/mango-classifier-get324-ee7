5 files\n","Folder: mango_raw/dataset/Train/freshpotato -> Contains 536 files\n","Folder: mango_raw/dataset/Train/freshokra -> Contains 635 files\n","Folder: mango_raw/dataset/Train/freshoranges -> Contains 1466 files\n","Folder: mango_raw/dataset/Train/freshapples -> Contains 2424 files\n","Folder: mango_raw/dataset/Train/freshtomato -> Contains 1858 files\n","Folder: mango_raw/dataset/Train/rottenpotato -> Contains 802 files\n","Folder: mango_raw/dataset/Train/rottencapsicum -> Contains 901 files\n","Folder: mango_raw/dataset/Train/freshbanana -> Contains 2468 files\n","Folder: mango_raw/dataset/Train/rottencucumber -> Contains 421 files\n","Folder: mango_raw/dataset/Train/freshcucumber -> Contains 496 files\n","Folder: mango_raw/dataset/Train/rottenoranges -> Contains 1595 files\n","Folder: mango_raw/dataset/Train/rottenbanana -> Contains 2932 files\n","Folder: mango_raw/dataset/Train/freshbittergroud -> Contains 327 files\n","Folder: mango_raw/dataset/Train/rottenapples -> Contains 3248 files\n","Folder: mango_raw/dataset/Train/rottenokra -> Contains 338 files\n","Folder: mango_raw/dataset/Train/freshcapsicum -> Contains 990 files\n"]}]},{"cell_type":"code","source":["# 1. Clear out previous directories to save RAM/Disk\n","!rm -rf raw_data mango_raw mango_dataset\n","\n","# 2. Download and unzip the lightweight (11.2 MB) nourabdoun dataset\n","!kaggle datasets download -d nourabdoun/fruits-quality-fresh-vs-rotten\n","!unzip -q fruits-quality-fresh-vs-rotten.zip -d raw_data\n","\n","# 3. List all subfolders inside 'train'\n","import os\n","train_path = 'raw_data/Quality Dataset/train'\n","print(\"Folders inside Quality Dataset/train:\")\n","print(os.listdir(train_path))"],"metadata":{"id":"4_hfc0-Vm3LT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Remove all previously extracted folders and zip files\n","!rm -rf raw_data mango_raw mango_dataset\n","!rm -f fruits-quality-fresh-vs-rotten.zip fresh-and-stale-classification.zip fruitquality1.zip\n","\n","print(\"Cleanup complete! Disk space cleared.\")"],"metadata":{"id":"h8PQgF4_nuuJ","executionInfo":{"status":"ok","timestamp":1784972093726,"user_tz":-60,"elapsed":4513,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"bd6fda9c-5b09-4a77-b942-4191eb5ae639","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Cleanup complete! Disk space cleared.\n"]}]},{"cell_type":"code","source":["import os\n","\n","# Download and unzip the targeted dataset\n","!kaggle datasets download -d zlatan599/fruitquality1\n","!unzip -q fruitquality1.zip -d mango_raw\n","\n","print(\"Download complete! Checking structure...\")"],"metadata":{"id":"zBmOklb-pwd9","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1784973292365,"user_tz":-60,"elapsed":137461,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"6b4d376e-3dff-4aaa-a527-9949b00cddd9"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Warning: Looks like you're using an outdated `kaggle` version (installed: 2.0.2), please consider upgrading to the latest version (2.2.2)\n","Dataset URL: https://www.kaggle.com/datasets/zlatan599/fruitquality1\n","License(s): MIT\n","Downloading fruitquality1.zip to /content\n","100% 4.77G/4.77G [01:05<00:00, 77.8MB/s]\n","\n","Download complete! Checking structure...\n"]}]},{"cell_type":"code","source":["import shutil\n","\n","base_dir = 'mango_dataset'\n","fresh_target = os.path.join(base_dir, 'fresh')\n","rotten_target = os.path.join(base_dir, 'rotten')\n","\n","os.makedirs(fresh_target, exist_ok=True)\n","os.makedirs(rotten_target, exist_ok=True)\n","\n","# Find all mango folders inside mango_raw recursively and copy them\n","for root, dirs, files in os.walk(\"mango_raw\"):\n","    root_lower = root.lower()\n","    if 'mango' in root_lower:\n","        if 'fresh' in root_lower:\n","            for f in files:\n","                if f.lower().endswith(('.jpg', '.jpeg', '.png')):\n","                    shutil.copy(os.path.join(root, f), os.path.join(fresh_target, f\"{root.replace('/', '_')}_{f}\"))\n","        elif 'rotten' in root_lower or 'stale' in root_lower:\n","            for f in files:\n","                if f.lower().endswith(('.jpg', '.jpeg', '.png')):\n","                    shutil.copy(os.path.join(root, f), os.path.join(rotten_target, f\"{root.replace('/', '_')}_{f}\"))\n","\n","print(f\"Extraction Complete!\")\n","print(f\"Fresh Mangoes isolated: {len(os.listdir(fresh_target))}\")\n","print(f\"Rotten Mangoes isolated: {len(os.listdir(rotten_target))}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jTC_ddd_s2oZ","executionInfo":{"status":"ok","timestamp":1784973395507,"user_tz":-60,"elapsed":52242,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"2c70913f-69d4-4668-82fc-ce40a4eaec94"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Extraction Complete!\n","Fresh Mangoes isolated: 13784\n","Rotten Mangoes isolated: 15493\n"]}]},{"cell_type":"code","source":["import tensorflow as tf\n","from tensorflow.keras.preprocessing.image import ImageDataGenerator\n","from tensorflow.keras.applications import MobileNetV2\n","from tensorflow.keras import layers, models\n","\n","# Parameters\n","IMG_SIZE = (224, 224)\n","BATCH_SIZE = 32\n","EPOCHS = 5\n","\n","# 1. Data Generators (Split dataset into 80% Train, 20% Validation)\n","train_datagen = ImageDataGenerator(\n","    rescale=1.0/255.0,\n","    rotation_range=20,\n","    zoom_range=0.15,\n","    horizontal_flip=True,\n","    validation_split=0.2\n",")\n","\n","print(\"Loading Training Data...\")\n","train_generator = train_datagen.flow_from_directory(\n","    'mango_dataset',\n","    target_size=IMG_SIZE,\n","    batch_size=BATCH_SIZE,\n","    class_mode='binary',\n","    subset='training',\n","    shuffle=True\n",")\n","\n","print(\"\\nLoading Validation Data...\")\n","val_generator = train_datagen.flow_from_directory(\n","    'mango_dataset',\n","    target_size=IMG_SIZE,\n","    batch_size=BATCH_SIZE,\n","    class_mode='binary',\n","    subset='validation',\n","    shuffle=False\n",")\n","\n","# Verify Class Order (0: Fresh or Rotten)\n","print(\"\\nClass Indices Mapping:\", train_generator.class_indices)\n","\n","# 2. Build MobileNetV2 Transfer Learning Architecture\n","base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))\n","base_model.trainable = False  # Freeze pretrained weights for speed\n","\n","model = models.Sequential([\n","    base_model,\n","    layers.GlobalAveragePooling2D(),\n","    layers.Dropout(0.2),\n","    layers.Dense(1, activation='sigmoid')  # Binary classification output\n","])\n","\n","model.compile(\n","    optimizer='adam',\n","    loss='binary_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","# 3. Train the Model\n","print(\"\\nStarting Training...\")\n","history = model.fit(\n","    train_generator,\n","    epochs=EPOCHS,\n","    validation_data=val_generator\n",")\n","\n","# 4. Save Trained Model for Deployment\n","model.save('mango_classifier.h5')\n","print(\"\\nModel training complete! Saved as 'mango_classifier.h5'\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OFBVyG5bzpq4","executionInfo":{"status":"ok","timestamp":1784984051073,"user_tz":-60,"elapsed":93725,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"19947fdd-80c0-48e9-f301-31018cb2f71a"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Loading Training Data...\n","Found 23423 images belonging to 2 classes.\n","\n","Loading Validation Data...\n","Found 5854 images belonging to 2 classes.\n","\n","Class Indices Mapping: {'fresh': 0, 'rotten': 1}\n","\n","Starting Training...\n","Epoch 1/5\n","\u001b[1m732/732\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1725s\u001b[0m 2s/step - accuracy: 0.8765 - loss: 0.2981 - val_accuracy: 0.8690 - val_loss: 0.2907\n","Epoch 2/5\n","\u001b[1m732/732\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1736s\u001b[0m 2s/step - accuracy: 0.9200 - loss: 0.2077 - val_accuracy: 0.8587 - val_loss: 0.3096\n","Epoch 3/5\n","\u001b[1m732/732\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1724s\u001b[0m 2s/step - accuracy: 0.9296 - loss: 0.1861 - val_accuracy: 0.8596 - val_loss: 0.3075\n","Epoch 4/5\n","\u001b[1m732/732\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1694s\u001b[0m 2s/step - accuracy: 0.9325 - loss: 0.1816 - val_accuracy: 0.8644 - val_loss: 0.2966\n","Epoch 5/5\n","\u001b[1m732/732\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1689s\u001b[0m 2s/step - accuracy: 0.9330 - loss: 0.1762 - val_accuracy: 0.8580 - val_loss: 0.3172\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:absl:You are saving your model as an HDF5 file via `model.save()` or `keras.saving.save_model(model)`. This file format is considered legacy. We recommend using instead the native Keras format, e.g. `model.save('my_model.keras')` or `keras.saving.save_model(model, 'my_model.keras')`. \n"]},{"output_type":"stream","name":"stdout","text":["\n","Model training complete! Saved as 'mango_classifier.h5'\n"]}]}]}
