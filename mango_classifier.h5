n","['Quality Dataset']\n"]}]},{"cell_type":"code","source":["import os\n","import shutil\n","\n","# 1. Path to the unzipped contents\n","dataset_path = 'raw_data/Quality Dataset'\n","\n","# Check subfolders inside Quality Dataset\n","print(\"Folders inside Quality Dataset:\")\n","print(os.listdir(dataset_path))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ECu-L8t-gcSG","executionInfo":{"status":"ok","timestamp":1784970082876,"user_tz":-60,"elapsed":158,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"45826b05-18b0-4224-9169-ca2d648aee35"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Folders inside Quality Dataset:\n","['test', 'valid', 'train']\n"]}]},{"cell_type":"code","source":["# Create clean dataset directory\n","base_dir = 'mango_dataset'\n","fresh_dir = os.path.join(base_dir, 'fresh')\n","rotten_dir = os.path.join(base_dir, 'rotten')\n","\n","os.makedirs(fresh_dir, exist_ok=True)\n","os.makedirs(rotten_dir, exist_ok=True)\n","\n","# Copy files matching fresh mango and rotten mango\n","for folder in os.listdir(dataset_path):\n","    folder_lower = folder.lower()\n","    full_folder_path = os.path.join(dataset_path, folder)\n","\n","    if os.path.isdir(full_folder_path):\n","        if 'fresh' in folder_lower and 'mango' in folder_lower:\n","            for f in os.listdir(full_folder_path):\n","                shutil.copy(os.path.join(full_folder_path, f), os.path.join(fresh_dir, f))\n","            print(f\"Copied fresh mangoes from {folder}\")\n","\n","        elif ('rotten' in folder_lower or 'stale' in folder_lower) and 'mango' in folder_lower:\n","            for f in os.listdir(full_folder_path):\n","                shutil.copy(os.path.join(full_folder_path, f), os.path.join(rotten_dir, f))\n","            print(f\"Copied rotten mangoes from {folder}\")\n","\n","# Verify final image counts\n","print(f\"\\nFresh Mango images: {len(os.listdir(fresh_dir))}\")\n","print(f\"Rotten Mango images: {len(os.listdir(rotten_dir))}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EdCd7btkghda","executionInfo":{"status":"ok","timestamp":1784970138793,"user_tz":-60,"elapsed":71,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"cdae1e0b-5409-4d4f-c77c-01b211acda1f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Fresh Mango images: 0\n","Rotten Mango images: 0\n"]}]},{"cell_type":"code","source":["import os\n","\n","# Check subfolders inside 'train'\n","train_path = 'raw_data/Quality Dataset/train'\n","if os.path.exists(train_path):\n","    print(\"Folders inside 'train':\")\n","    print(os.listdir(train_path))"],"metadata":{"id":"fqGBESEYisZM","executionInfo":{"status":"ok","timestamp":1784970672686,"user_tz":-60,"elapsed":128,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"40f19404-717e-417a-e11e-3b82662f7b44","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Folders inside 'train':\n","['rotten', 'fresh']\n"]}]},{"cell_type":"code","source":["import os\n","import shutil\n","\n","# Target directory\n","base_dir = 'mango_dataset'\n","fresh_target = os.path.join(base_dir, 'fresh')\n","rotten_target = os.path.join(base_dir, 'rotten')\n","\n","os.makedirs(fresh_target, exist_ok=True)\n","os.makedirs(rotten_target, exist_ok=True)\n","\n","splits = ['train', 'valid', 'test']\n","categories = ['fresh', 'rotten']\n","\n","fresh_count = 0\n","rotten_count = 0\n","\n","for split in splits:\n","    for cat in categories:\n","        folder_path = os.path.join('raw_data/Quality Dataset', split, cat)\n","        if os.path.exists(folder_path):\n","            target_dir = fresh_target if cat == 'fresh' else rotten_target\n","\n","            for file_name in os.listdir(folder_path):\n","                # Check if image name contains 'mango'\n","                if 'mango' in file_name.lower():\n","                    src_file = os.path.join(folder_path, file_name)\n","                    # Unique filename to avoid overwriting across splits\n","                    dst_file = os.path.join(target_dir, f\"{split}_{file_name}\")\n","                    shutil.copy(src_file, dst_file)\n","\n","                    if cat == 'fresh':\n","                        fresh_count += 1\n","                    else:\n","                        rotten_count += 1\n","\n","print(f\"Extraction Complete!\")\n","print(f\"Total Fresh Mango images copied: {fresh_count}\")\n","print(f\"Total Rotten Mango images copied: {rotten_count}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Qf7xBaujjugo","executionInfo":{"status":"ok","timestamp":1784970945248,"user_tz":-60,"elapsed":87,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"c3883dc1-9c2d-45fd-c447-181354da0276"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Extraction Complete!\n","Total Fresh Mango images copied: 0\n","Total Rotten Mango images copied: 3\n"]}]},{"cell_type":"code","source":["# Download a dedicated fresh vs rotten mango dataset\n","!kaggle datasets download -d swoyam2609/fresh-and-stale-classification\n","\n","# Unzip the contents\n","!unzip -q fresh-and-stale-classification.zip -d mango_raw"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"4nOh88ZqkmYw","executionInfo":{"status":"ok","timestamp":1784971262781,"user_tz":-60,"elapsed":94263,"user":{"displayName":"Kufre Archibong","userId":"10430292710532108250"}},"outputId":"05d0b83f-4621-4224-c1e1-9127f4fbc433"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Warning: Looks like you're using an outdated `kaggle` version (installed: 2.0.2), please consider upgrading to the latest version (2.2.2)\n","Dataset URL: https://www.kaggle.com/data